## Production build environment file (used by: `npm run prod`)
## IMPORTANT: do not commit real secrets; keep them in your CI/CD secrets instead.

NEXT_PUBLIC_API_BASE_URL=https://your-backend-domain.example

NEXTAUTH_URL=https://your-frontend-domain.example
NEXTAUTH_SECRET=replace-with-a-long-random-string

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

